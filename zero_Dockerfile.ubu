ARG UBUNTU_DIST=noble
FROM ubuntu:$UBUNTU_DIST

ARG ZLS_VERSION
ARG ZIG_VERSION
ARG UBUNTU_DIST
ARG BUILD_VERSION
ARG FULL_VERSION
ARG DEB_ARCH=amd64

RUN mkdir -p /output/usr/lib/zls/$ZLS_VERSION
COPY dist/${DEB_ARCH}/zls /output/usr/lib/zls/$ZLS_VERSION/
RUN chmod 755 /output/usr/lib/zls/$ZLS_VERSION/zls

RUN mkdir -p /output/DEBIAN
RUN mkdir -p /output/usr/share/doc/zls-0/

COPY packages/zero/output/DEBIAN/control /output/DEBIAN/
COPY packages/zero/output/DEBIAN/postinst /output/DEBIAN/
COPY packages/zero/output/DEBIAN/prerm /output/DEBIAN/
COPY packages/zero/output/DEBIAN/postrm /output/DEBIAN/
RUN chmod 755 /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/prerm
RUN chmod 755 /output/DEBIAN/postrm

COPY packages/zero/output/changelog.Debian /output/usr/share/doc/zls-0/changelog.Debian
COPY packages/zero/output/copyright /output/usr/share/doc/zls-0/

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/usr/share/doc/zls-0/changelog.Debian
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/usr/share/doc/zls-0/changelog.Debian

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/DEBIAN/control
RUN sed -i "s/ZIG_VERSION/$ZIG_VERSION/" /output/DEBIAN/control
RUN sed -i "s/DEB_ARCH/$DEB_ARCH/" /output/DEBIAN/control

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/postinst
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/DEBIAN/postinst

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/prerm
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/DEBIAN/prerm

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/postrm
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/DEBIAN/postrm

RUN sed -i "s/DIST/$UBUNTU_DIST/g" /output/usr/share/doc/zls-0/changelog.Debian
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/control
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/postinst
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/prerm
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/postrm


RUN gzip -9n /output/usr/share/doc/zls-0/changelog.Debian
RUN find /output/usr -type f ! -path '*/lib/zls/*' -exec chmod 644 {} +

RUN dpkg-deb --build /output /zls-zero_${FULL_VERSION}.deb


