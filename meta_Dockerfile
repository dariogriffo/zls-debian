ARG DEBIAN_DIST=bookworm
FROM debian:$DEBIAN_DIST

ARG ZLS_VERSION
ARG DEBIAN_DIST
ARG BUILD_VERSION
ARG FULL_VERSION
ARG DEB_ARCH=amd64

RUN mkdir -p /output/DEBIAN
RUN mkdir -p /output/usr/share/doc/zls

COPY packages/zls/output/DEBIAN/control /output/DEBIAN/
COPY packages/zls/output/DEBIAN/postinst /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/postinst
COPY packages/zls/output/copyright /output/usr/share/doc/zls/
COPY packages/zls/output/changelog.Debian /output/usr/share/doc/zls/

RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/;s/ZLS_VERSION/$ZLS_VERSION/;s/DIST/$DEBIAN_DIST/g" /output/usr/share/doc/zls/changelog.Debian
RUN gzip -9n /output/usr/share/doc/zls/changelog.Debian
RUN find /output/usr -type f -exec chmod 644 {} +
RUN sed -i "s/DIST/$DEBIAN_DIST/" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/ZLS_VERSION/$ZLS_VERSION/" /output/DEBIAN/control
RUN sed -i "s/DEB_ARCH/$DEB_ARCH/" /output/DEBIAN/control

RUN dpkg-deb --build /output /zls_$FULL_VERSION.deb


